"pandas","snapshot_hash":"2ecedec8ecd4a2b6ef62da51592e7761"}],"upstream_entries":[],"traversable":true,"legit":true,"issues":[],"verdict":"VERIFIED","detail":"source(s) legitimate: read_csv(https://harvestlymarkets.com/data/us-farmers-markets-by-state-2026.csv) via pandas, read_csv(https://gist.githubusercontent.com/hussainsultan/369600f5179b22792a2b4c9ed37de056/raw/NST-EST2025-ALLDATA.csv) via pandas"},"isError":false,"timestamp":1786915359829}]}
