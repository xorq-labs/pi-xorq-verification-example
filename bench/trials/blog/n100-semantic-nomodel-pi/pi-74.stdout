{"type":"tool_execution_start","toolCallId":"toolu_01BVwxp8q8RmGWM7LYc4JNLD","toolName":"write","args":{"path":".xorq/scripts/farmers_markets_per_capita.py","content":"import urllib.request as u\nfrom xorq.vendor.ibis.common.collections import FrozenDict\nimport xorq.api as xo\n\n_o = u.build_opener()\n_o.addheaders = [(\"User-Agent\", \"Mozilla/5.0\")]\nu.install_opener(_o)\n\nso = FrozenDict({\"User-Agent\": \"Mozilla/5.0\"})\ncon = xo.pandas.connect()\n\n# Read farmers markets by state\nfm = xo.deferred_read_csv(\n    \"https://harvestlymarkets.com/data/us-farmers-markets-by-state-2026.csv\",\n    con,\n    storage_options=so\n)\n\n# Read census population data\ncensus = xo.deferred_read_csv(\n    \"https://gist.githubusercontent.com/hussainsultan/369600f5179b22792a2b4c9ed37de056/raw/NST-EST2025-ALLDATA.csv\",\n    con,\n    storage_options=so\n)\n\n# Get total farmers markets (sum all states)\ntotal_fm = fm.aggregate(total_markets=fm.farmers_markets.sum()).mutate(k=xo.literal(1))\n\n# Get US total population (SUMLEV == 10 is the US total)\ntotal_pop = (\n    census.filter(census.SUMLEV == 10)\n    .select(\"POPESTIMATE2025\")\n    .mutate(k=xo.literal(1))\n)\n\n# Join and calculate per capita\nexpr = (\n    total_fm.join(total_pop, total_fm.k == total_pop.k)\n    .mutate(markets_per_100k=total_fm.total_markets / total_pop.POPESTIMATE2025 * 100000)\n    .select(\"total_markets\", \"POPESTIMATE2025\", \"markets_per_100k\")\n)\n"}}
