ack(*args, **kwargs)\n  File \"/nix/store/yvlv6n4rx6dnnvhi7sgc5lm0152pa8mx-pi-xorq-duel-dev-env/lib/python3.13/site-packages/xorq/cli.py\", line 1149, in build\n    build_command(\n    ~~~~~~~~~~~~~^\n        script_path,\n        ^^^^^^^^^^^^\n    ...<5 lines>...\n        emit_build_path_to=emit_build_path_to,\n        ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n    )\n    ^\n  File \"/nix/store/yvlv6n4rx6dnnvhi7sgc5lm0152pa8mx-pi-xorq-duel-dev-env/lib/python3.13/site-packages/xorq/cli.py\", line 57, in wrapper\n    return fn(*args, **kwargs)\n  File \"/nix/store/yvlv6n4rx6dnnvhi7sgc5lm0152pa8mx-pi-xorq-duel-dev-env/lib/python3.13/site-packages/xorq/cli.py\", line 276, in build_command\n    vars_module = import_from_path(script_path, module_name=\"__main__\")\n  File \"/nix/store/yvlv6n4rx6dnnvhi7sgc5lm0152pa8mx-pi-xorq-duel-dev-env/lib/python3.13/site-packages/xorq/common/utils/import_utils.py\", line 77, in import_from_path\n    return import_python(path, module_name)\n  File \"/nix/store/yvlv6n4rx6dnnvhi7sgc5lm0152pa8mx-pi-xorq-duel-dev-env/lib/python3.13/site-packages/xorq/common/utils/import_utils.py\", line 13, in import_python\n    ).load_module()\n      ~~~~~~~~~~~^^\n  File \"<frozen importlib._bootstrap_external>\", line 677, in _check_name_wrapper\n  File \"<frozen importlib._bootstrap_external>\", line 1204, in load_module\n  File \"<frozen importlib._bootstrap_external>\", line 1028, in load_module\n  File \"<frozen importlib._bootstrap>\", line 534, in _load_module_shim\n  File \"<frozen importlib._bootstrap>\", line 866, in _exec\n  File \"<frozen importlib._bootstrap_external>\", line 1023, in exec_module\n  File \"<frozen importlib._bootstrap>\", line 488, in _call_with_frames_removed\n  File \".xorq/scripts/farmers_markets.py\", line 1, in <module>\n    import letsql as xo\nModuleNotFoundError: No module named 'letsql'\n\n\nCommand exited with code 1"}],"details":{},"isError":true,"timestamp":1786914943380}]}
