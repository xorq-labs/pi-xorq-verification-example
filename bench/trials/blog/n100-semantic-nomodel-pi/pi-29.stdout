port_utils.py\", line 77, in import_from_path\n    return import_python(path, module_name)\n  File \"/nix/store/yvlv6n4rx6dnnvhi7sgc5lm0152pa8mx-pi-xorq-duel-dev-env/lib/python3.13/site-packages/xorq/common/utils/import_utils.py\", line 13, in import_python\n    ).load_module()\n      ~~~~~~~~~~~^^\n  File \"<frozen importlib._bootstrap_external>\", line 677, in _check_name_wrapper\n  File \"<frozen importlib._bootstrap_external>\", line 1204, in load_module\n  File \"<frozen importlib._bootstrap_external>\", line 1028, in load_module\n  File \"<frozen importlib._bootstrap>\", line 534, in _load_module_shim\n  File \"<frozen importlib._bootstrap>\", line 866, in _exec\n  File \"<frozen importlib._bootstrap_external>\", line 1023, in exec_module\n  File \"<frozen importlib._bootstrap>\", line 488, in _call_with_frames_removed\n  File \".xorq/scripts/farmers_markets.py\", line 2, in <module>\n    from frozendict import FrozenDict\nModuleNotFoundError: No module named 'frozendict'\n\n\nCommand exited with code 1"}],"details":{},"isError":true,"timestamp":1786914674677}}
