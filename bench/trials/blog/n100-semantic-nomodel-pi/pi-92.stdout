      int64\n  NPOPCHG_2022             int64\n  NPOPCHG_2023             int64\n  NPOPCHG_2024             int64\n  NPOPCHG_2025             int64\n  BIRTHS2020               int64\n  BIRTHS2021               int64\n  BIRTHS2022               int64\n  BIRTHS2023               int64\n  BIRTHS2024               int64\n  BIRTHS2025               int64\n  DEATHS2020               int64\n  DEATHS2021               int64\n  DEATHS2022               int64\n  DEATHS2023               int64\n  DEATHS2024               int64\n  DEATHS2025               int64\n  NATURALCHG2020           int64\n  NATURALCHG2021           int64\n  NATURALCHG2022           int64\n  NATURALCHG2023           int64\n  NATURALCHG2024           int64\n  NATURALCHG2025           int64\n  INTERNATIONALMIG2020     int64\n  INTERNATIONALMIG2021     int64\n  INTERNATIONALMIG2022     int64\n  INTERNATIONALMIG2023     int64\n  INTERNATIONALMIG2024     int64\n  INTERNATIONALMIG2025     int64\n  DOMESTICMIG2020          int64\n  DOMESTICMIG2021          int64\n  DOMESTICMIG2022          int64\n  DOMESTICMIG2023          int64\n  DOMESTICMIG2024          int64\n  DOMESTICMIG2025          int64\n  NETMIG2020               int64\n  NETMIG2021               int64\n  NETMIG2022               int64\n  NETMIG2023               int64\n  NETMIG2024               int64\n  NETMIG2025               int64\n  RESIDUAL2020             int64\n  RESIDUAL2021             int64\n  RESIDUAL2022             int64\n  RESIDUAL2023             int64\n  RESIDUAL2024             int64\n  RESIDUAL2025             int64\n  GQESTIMATESBASE2020      int64\n  GQESTIMATES2020          int64\n  GQESTIMATES2021          int64\n  GQESTIMATES2022          int64\n  GQESTIMATES2023          int64\n  GQESTIMATES2024          int64\n  GQESTIMATES2025          int64\n  RBIRTH2021               float64\n  RBIRTH2022               float64\n  RBIRTH2023               float64\n  RBIRTH2024               float64\n  RBIRTH2025               float64\n  RDE