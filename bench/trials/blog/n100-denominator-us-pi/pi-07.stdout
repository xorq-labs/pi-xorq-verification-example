shape:scalar  ✓ typed_eq  ✓ provenance\n      witness verify-fm_per_100k  sha256:776590a74563aa9b\nanswer contract: every figure in the final answer must be discharged — this certificate covers: 7942, 341784857, 2.3237, 2.32368398931144. A supporting number you did not verify (totals, populations) must be verified too or left out."}],"details":{"verdict":"VERIFIED","obligations":[{"id":"total_fm","status":"DISCHARGED","checks":{"witness_on_declared_alias":true,"noncircular":true,"selection_only":true,"shape:scalar":true,"typed_eq":true,"provenance":true},"surface":"7942","selected_cell":"7942","value_type":{"kind":"int","tolerance":"0"},"base_alias":"fm_per_capita","witness_code":"source.select('total_fm')","witness_hash":"sha256:32b18fd85716c172","witness_ref":"verify-total_fm","sources":["<RemoteTable:ibis_rbr-placeholder_l54usni4rbaavl>","https://gist.githubusercontent.com/hussainsultan/369600f5179b22792a2b4c9ed37de056/raw/NST-EST2025-ALLDATA.csv","https://harvestlymarkets.com/data/us-farmers-markets-by-state-2026.csv"],"detail":""},{"id":"us_pop_2025","status":"DISCHARGED","checks":{"witness_on_declared_alias":true,"noncircular":true,"selection_only":true,"shape:scalar":true,"typed_eq":true,"provenance":true},"surface":"341784857","selected_cell":"341784857","value_type":{"kind":"int","tolerance":"0"},"base_alias":"fm_per_capita","witness_code":"source.select('POPESTIMATE2025')","witness_hash":"sha256:cbc862b2a8212f4f","witness_ref":"verify-us_pop_2025","sources":["<RemoteTable:ibis_rbr-placeholder_gv7bvmqhczhxnk>","https://gist.githubusercontent.com/hussainsultan/369600f5179b22792a2b4c9ed37de056/raw/NST-EST2025-ALLDATA.csv","https://harvestlymarkets.com/data/us-farmers-markets-by-state-2026.csv"],"detail":""},{"id":"fm_per_100k","status":"DISCHARGED","checks":{"witness_on_declared_alias":true,"noncircular":true,"selection_only":true,"shape:scalar":true,"typed_eq":true,"provenance":true},"surface":"2.3237","selected_cell":"2.32368398931144","value_type":{"kind":